{
  "sites": [
    "sc-domain:booksversusmovies.com"
  ],
  "periods": [
    {
      "name": "28days",
      "daysBack": 28
    },
    {
      "name": "7days",
      "daysBack": 7
    },
    {
      "name": "24hours",
      "daysBack": 1
    }
  ],
  "dimensions": [
    "query",
    "page"
  ],
  "rowLimit": 150,
  "llm": {
    "provider": "openrouter",
    "model": "x-ai/grok-3",
    "temperature": 0.3,
    "apiKeyEnv": "OPENROUTER_API_KEY",
    "maxTokens": 12000
  },
  "output": {
    "dir": "data/reports",
    "prefix": "gsc-insights"
  }
}