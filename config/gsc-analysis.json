{
  "sites": [
    "sc-domain:booksversusmovies.com"
  ],
  "periods": [
    { "name": "3months", "daysBack": 90 },
    { "name": "24hours", "daysBack": 1 }
  ],
  "dimensions": ["query", "page"],
  "rowLimit": 150,
  "llm": {
    "provider": "openrouter",
    "model": "anthropic/claude-haiku-4-5",
    "temperature": 0.3,
    "apiKeyEnv": "OPENROUTER_API_KEY"
  },
  "output": {
    "dir": "data/reports",
    "prefix": "gsc-insights"
  }
}